#!/bin/sh
# Dedicated quiet hook launcher. Capturing this pid before exec gives the Lua
# handler a stable place to begin its parent-process walk.
set -e
umask 077

AGENT_TRACKER_HOOK_PID=$$
AGENT_TRACKER_UID=$(id -u)
export AGENT_TRACKER_HOOK_PID AGENT_TRACKER_UID

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# Silent whether it works or not. Without this, a machine with no lua prints
# "no lua interpreter found" on every lifecycle event, and hook output is one of
# the few things that can reach Codex's own UI.
exec "$root/bin/tmux-agent-tracker" codex-hook >/dev/null 2>&1
